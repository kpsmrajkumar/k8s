// © Raj
//@version=6

strategy("raj master strategy", shorttitle="raj master strategy", overlay=true,
     default_qty_type=strategy.percent_of_equity, default_qty_value=100,
     commission_type=strategy.commission.percent, commission_value=0.1,
     slippage=3, initial_capital=100000, currency=currency.INR,
     pyramiding=0, calc_on_every_tick=false)

//───────────────────────────────
// Inputs — VW Bands Core
//───────────────────────────────
len         = input.int(24, "Trend Length")
smoothLen   = input.int(7, "Extra Smoothing")
bandMult    = input.float(1.5, "Band Width (ATR Multiplier)", step = 0.1)
atrLen      = input.int(14, "ATR Length")
showSignals  = input.bool(true,  "Show Buy/Sell Signals")
showBarColor = input.bool(false, "Color Bars")
visualMode   = input.string("Cloud", "Visual Mode", options = ["Cloud", "Single Band", "Line Only"])
show_ema50   = input.bool(true,    "Show EMA 50",   group="EMA")
ema50_len    = input.int(50,       "EMA 50 Length",  minval=1, maxval=500, group="EMA")
ema50_col    = input.color(color.orange, "EMA 50 Color", group="EMA")
show_ema100  = input.bool(true,    "Show EMA 100",  group="EMA")
ema100_len   = input.int(100,      "EMA 100 Length", minval=1, maxval=500, group="EMA")
ema100_col   = input.color(color.blue, "EMA 100 Color", group="EMA")
show_ema200  = input.bool(true,    "Show EMA 200",  group="EMA")
ema200_len   = input.int(200,      "EMA 200 Length", minval=1, maxval=500, group="EMA")
ema200_col   = input.color(#000000, "EMA 200 Color", group="EMA")

//───────────────────────────────
// Core Calculation
//───────────────────────────────
vwma = ta.vwma(close, len)
ema  = ta.ema(close, len)
rawLine   = (vwma + ema) / 2
trendLine = ta.ema(rawLine, smoothLen)

//───────────────────────────────
// Band Calculation
//───────────────────────────────
atr        = ta.atr(atrLen)
upperBand  = trendLine + atr * bandMult
lowerBand  = trendLine - atr * bandMult

//───────────────────────────────
// Trend Detection
//───────────────────────────────
trendUp = close > upperBand
trendDn = close < lowerBand

var float trendState = na
if trendUp
    trendState := 1
else if trendDn
    trendState := -1
else
    trendState := nz(trendState[1])

//───────────────────────────────
// Colors (Uptrick Palette)
//───────────────────────────────
bull     = color.rgb(92, 240, 215)
bear     = color.rgb(179, 42, 195)
neutral  = color.new(color.gray, 80)
trendCol = trendState == 1 ? bull : trendState == -1 ? bear : neutral

//───────────────────────────────
// Visualization Controls
//───────────────────────────────
showCloud  = visualMode == "Cloud"
showSingle = visualMode == "Single Band"
showLine   = visualMode == "Line Only"

// Active Band (for Single Band mode)
singleBand = trendState == 1 ? lowerBand : trendState == -1 ? upperBand : na

//───────────────────────────────
// Plot Logic
//───────────────────────────────
pUpper  = plot(showCloud ? upperBand : na, "Upper Band", color = color.new(trendCol, 60))
pLower  = plot(showCloud ? lowerBand : na, "Lower Band", color = color.new(trendCol, 60))
pLine   = plot(showCloud or showLine ? trendLine : na, "Trend Line", color = trendCol, linewidth = 1)
pSingle = plot(showSingle ? singleBand : na, "Active Band", color = color.new(trendCol, 30), linewidth = 1)

// Fill for Cloud mode
fill(pUpper, pLower, color = showCloud ? color.new(trendCol, 85) : na)

//───────────────────────────────
// Gradient Fill for Single Band Mode
//───────────────────────────────
pClose = plot(showSingle ? close : na, display = display.none)

fill(pSingle, pClose, singleBand, close, color.new(trendCol, 80), na)

barcolor(showBarColor ? trendCol : na)

//───────────────────────────────
// EMA 50 / 100 / 200
//───────────────────────────────
ema50  = ta.ema(close, ema50_len)
ema100 = ta.ema(close, ema100_len)
ema200 = ta.ema(close, ema200_len)
plot(show_ema50  ? ema50  : na, "EMA 50",  color=ema50_col,  linewidth=2)
plot(show_ema100 ? ema100 : na, "EMA 100", color=ema100_col, linewidth=2)
plot(show_ema200 ? ema200 : na, "EMA 200", color=ema200_col, linewidth=2)

//───────────────────────────────
// Strategy Logic — Buy: above EMA 100 + VW blue | Exit: VW pink or close below VW mid line
//───────────────────────────────
buySignal   = close > ema100 and trendState == 1

vwTurnsBear      = trendState == -1 and nz(trendState[1]) != -1
belowVWMid       = close < trendLine
sellSignal       = vwTurnsBear or belowVWMid

if buySignal and strategy.position_size == 0
    strategy.entry("Long", strategy.long)

if sellSignal and strategy.position_size > 0
    strategy.close("Long", comment = vwTurnsBear ? "VW Pink" : "Below VW Mid")

//───────────────────────────────
// Visual Signals
//───────────────────────────────
exitFired = strategy.position_size[1] > 0 and strategy.position_size == 0

plotshape(showSignals and buySignal  and strategy.position_size[1] == 0, title="BUY",  style=shape.labelup,   location=location.belowbar, color=color.new(#00C853, 0), text="BUY",  textcolor=color.white, size=size.small)
plotshape(showSignals and exitFired,                                      title="SELL", style=shape.labeldown, location=location.abovebar, color=color.new(#D50000, 0), text="SELL", textcolor=color.white, size=size.small)

//───────────────────────────────
// Alerts
//───────────────────────────────
alertcondition(buySignal,    "BUY Signal",        "{{ticker}} — BUY: Close above EMA 100 and VW is blue")
alertcondition(vwTurnsBear,  "SELL — VW Pink",    "{{ticker}} — SELL: VW band turned pink")
alertcondition(belowVWMid,   "SELL — Below VW Mid", "{{ticker}} — SELL: Close dropped below VW mid line")
